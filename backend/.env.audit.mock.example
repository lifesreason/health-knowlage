# 机审模板（MOCK）
# 用途：本地开发与联调，无需云账号

AUDIT_MACHINE_ENABLED=true
AUDIT_MACHINE_REVIEW_ENABLED=true
AUDIT_MACHINE_PROVIDER=mock

# 消费参数
AUDIT_MACHINE_INTERVAL_MS=5000
AUDIT_MACHINE_BATCH_SIZE=1
AUDIT_MACHINE_MAX_RETRY=2

# 决策策略
AUDIT_MACHINE_AUTO_PASS=true
AUDIT_MACHINE_AUTO_REJECT=false

# mock 规则词（英文逗号分隔）
# 命中 block 词：decision=reject
# 命中 review 词：decision=review
# 未命中：decision=pass
AUDIT_MACHINE_BLOCK_WORDS=违禁词A,违禁词B
AUDIT_MACHINE_REVIEW_WORDS=疑似词A,疑似词B
