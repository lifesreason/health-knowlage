# 应用配置
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# 数据库配置 (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=silverhealth
DB_SYNCHRONIZE=true
DB_LOGGING=true

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=30d

# 微信小程序配置
WX_APP_ID=wxa1b1a93dbed3c175
WX_APP_SECRET=ccc7b1aaaf1e272448009eb1358305d3
# 开发环境可启用 mock 登录（true/false）
WX_LOGIN_MOCK_ENABLED=false

# OSS 配置 (阿里云/腾讯云)
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=your_bucket_name

# 短信服务配置
# 提供商: mock | aliyun | tencent
SMS_PROVIDER=mock
SMS_ACCESS_KEY_ID=your_sms_access_key_id
SMS_ACCESS_KEY_SECRET=your_sms_access_key_secret
SMS_SIGN_NAME=your_sign_name
SMS_TEMPLATE_CODE=your_template_code
# 开发联调用固定验证码（可选，生产建议留空）
SMS_FIXED_CODE=
# 单手机号每日验证码上限
SMS_DAILY_LIMIT=10

# 阿里云短信扩展配置（可选）
SMS_ALIYUN_REGION=cn-hangzhou
SMS_ALIYUN_ENDPOINT=https://dysmsapi.aliyuncs.com/

# 腾讯云短信配置（启用 tencent 时必填）
SMS_TENCENT_SECRET_ID=
SMS_TENCENT_SECRET_KEY=
SMS_TENCENT_SDK_APP_ID=
SMS_TENCENT_REGION=ap-guangzhou

# 机审队列配置（可选）
AUDIT_MACHINE_REVIEW_ENABLED=false
AUDIT_MACHINE_REVIEW_INTERVAL_MS=5000
AUDIT_MACHINE_BLOCK_WORDS=
AUDIT_MACHINE_AUTO_REJECT=false

# Feed 推荐缓存（秒）
FEED_RECOMMEND_CACHE_TTL=600

# AES 加密密钥 (用于手机号加密)
AES_SECRET_KEY=your_aes_secret_key_32bytes

# CORS 配置
CORS_ORIGIN=http://localhost:8080,https://your-domain.com
