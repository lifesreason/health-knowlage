# 机审模板（TENCENT）
# 用途：腾讯云内容安全联调

AUDIT_MACHINE_ENABLED=true
AUDIT_MACHINE_REVIEW_ENABLED=true
AUDIT_MACHINE_PROVIDER=tencent

# 消费参数
AUDIT_MACHINE_INTERVAL_MS=5000
AUDIT_MACHINE_BATCH_SIZE=1
AUDIT_MACHINE_MAX_RETRY=2

# 决策策略
AUDIT_MACHINE_AUTO_PASS=true
AUDIT_MACHINE_AUTO_REJECT=false

# 腾讯云内容安全配置（必填）
AUDIT_TENCENT_SECRET_ID=your_secret_id
AUDIT_TENCENT_SECRET_KEY=your_secret_key
AUDIT_TENCENT_REGION=ap-guangzhou
AUDIT_TENCENT_BIZ_TYPE=
