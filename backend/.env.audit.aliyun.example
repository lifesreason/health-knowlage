# 机审模板（ALIYUN）
# 用途：阿里云内容安全联调

AUDIT_MACHINE_ENABLED=true
AUDIT_MACHINE_REVIEW_ENABLED=true
AUDIT_MACHINE_PROVIDER=aliyun

# 消费参数
AUDIT_MACHINE_INTERVAL_MS=5000
AUDIT_MACHINE_BATCH_SIZE=1
AUDIT_MACHINE_MAX_RETRY=2

# 决策策略
AUDIT_MACHINE_AUTO_PASS=true
AUDIT_MACHINE_AUTO_REJECT=false

# 阿里云内容安全配置（必填）
AUDIT_ALIYUN_ACCESS_KEY_ID=your_access_key_id
AUDIT_ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
AUDIT_ALIYUN_APP_KEY=your_app_key
AUDIT_ALIYUN_ENDPOINT=https://green-cip.cn-shanghai.aliyuncs.com/green/text/scan
AUDIT_ALIYUN_BIZ_TYPE=
